    "test:e2e": "playwright test",
    "test:rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rls.sql"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.110.6",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "next": "15.5.20",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.3",
    "postcss": "8.5.19",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.11.0"
  }
