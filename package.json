{
  "name": "keivis-assistant",
  "version": "0.11.0-rc.3",
  "private": true,
  "description": "PWA privada de productividad, calendario, gimnasio e ingresos de delivery.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
